# Copy to .env. Change SECRET_KEY before using with real applicant data.
SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=sqlite:///./data/interviewloop.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATA_DIR=./data
DEMO_MODE=false
MAX_CV_MB=8
MAX_VIDEO_MB=60

# ENTERPRISE OPTIONAL PROVIDERS (all disabled by default)
REALTIME_MODEL=gpt-realtime-2.1
# Judge0 API must be a trusted HTTPS URL. No code ever runs in your API process.
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_API_HOST=
ENABLE_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Run in-app interview reminder checks every 5 minutes (one FastAPI process)
ENABLE_REMINDERS=true
